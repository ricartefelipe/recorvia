# Ambiente local do Recorvia. Copie para .env (make env).
# Todos os valores abaixo são exclusivos do ambiente de desenvolvimento local
# e não devem ser reutilizados em nenhum outro ambiente.

COMPOSE_PROJECT_NAME=recorvia

# PostgreSQL (superusuário usado apenas no bootstrap de papéis)
POSTGRES_SUPERUSER_PASSWORD=local-postgres-superuser
RECORVIA_OWNER_PASSWORD=local-owner-password
RECORVIA_APP_PASSWORD=local-app-password

# RabbitMQ
RABBITMQ_USER=recorvia
RABBITMQ_PASSWORD=local-rabbitmq-password

# Keycloak
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=local-keycloak-admin
RECORVIA_OIDC_CLIENT_SECRET=local-oidc-client-secret

# Chave de cifragem de credenciais (32 bytes em base64). Gere uma nova com:
#   openssl rand -base64 32
RECORVIA_ENCRYPTION_KEYS=local1:bG9jYWwtZGV2LW9ubHktZW5jcnlwdGlvbi1rZXkxMjM=
RECORVIA_ENCRYPTION_ACTIVE_KEY=local1

# Segredo HMAC do simulador de pagamentos para webhooks
PAYSIM_WEBHOOK_SECRET=local-paysim-webhook-secret

# E-mail: o ambiente local envia pelo Mailpit (mailpit:1025, sem TLS, remetente
# cobranca@recorvia.local, tempo limite de 15 s), configurado no compose.yaml.
# As mensagens ficam em http://localhost:${MAILPIT_UI_PORT}. Para outro servidor,
# defina RECORVIA_SMTP_ADDR, RECORVIA_SMTP_FROM, RECORVIA_SMTP_USERNAME,
# RECORVIA_SMTP_PASSWORD, RECORVIA_SMTP_TLS (none, starttls ou tls) e
# RECORVIA_SMTP_TIMEOUT no ambiente do worker (a API não envia e-mails).

# Retenção: prazos, em dias, do expurgo automático de dados técnicos pelo worker
# (tarefa retention.purge, a cada hora). Os valores abaixo são os padrões; a API
# e o worker não sobem com um prazo abaixo do mínimo indicado ou acima de 3650.
# Registros financeiros e de auditoria não têm prazo: não são expurgados.
# Detalhes em docs/operacao/retencao-e-anonimizacao.md.
# Registros de deduplicação dos consumidores (mínimo 14)
RECORVIA_RETENTION_INBOX_DAYS=90
# Dead letters tratadas (mínimo 30)
RECORVIA_RETENTION_DEAD_LETTERS_DAYS=180
# Entregas concluídas, eventos e segredos vencidos dos webhooks enviados (mínimo 7)
RECORVIA_RETENTION_WEBHOOKS_DAYS=90
# Corpo dos webhooks recebidos do provedor já processados (mínimo 7)
RECORVIA_RETENTION_PROVIDER_WEBHOOK_PAYLOADS_DAYS=90
# Conteúdo das notificações encerradas (mínimo 7)
RECORVIA_RETENTION_NOTIFICATION_CONTENT_DAYS=90
# Notificações e histórico de envio (mínimo 30; não menor que o do conteúdo)
RECORVIA_RETENTION_NOTIFICATIONS_DAYS=365
# Links do portal depois do fim da validade (mínimo 1)
RECORVIA_RETENTION_PORTAL_LINKS_DAYS=90
# Eventos de consumo de períodos já faturados (mínimo 30)
RECORVIA_RETENTION_USAGE_EVENTS_DAYS=400
# Convites não aceitos depois do fim da validade (mínimo 7)
RECORVIA_RETENTION_INVITATIONS_DAYS=90
# Registros removidos por transação (10 a 5000)
RECORVIA_RETENTION_BATCH_SIZE=500

# Grafana (perfil observability: make up-obs)
GRAFANA_ADMIN_PASSWORD=local-grafana-admin

# Alertmanager (perfil observability). No ambiente local, os alertas são
# enviados por e-mail ao Mailpit (mailpit:1025, sem TLS, de
# alertas@recorvia.local para plantao@recorvia.local) e o webhook fica
# desligado; os valores são resolvidos na partida do container. Para outros
# destinos, defina as variáveis abaixo (docs/operacao/observabilidade.md):
#   ALERTMANAGER_SMTP_SMARTHOST, ALERTMANAGER_SMTP_FROM,
#   ALERTMANAGER_SMTP_REQUIRE_TLS, ALERTMANAGER_SMTP_USERNAME,
#   ALERTMANAGER_SMTP_PASSWORD, ALERTMANAGER_EMAIL_TO,
#   ALERTMANAGER_EMAIL_TO_CRITICAL, ALERTMANAGER_WEBHOOK_URL e
#   ALERTMANAGER_WEBHOOK_BEARER_TOKEN.
# Com autenticação no SMTP, defina usuário e senha juntos e
# ALERTMANAGER_SMTP_REQUIRE_TLS=true: o padrão do compose é false, por causa
# do Mailpit, e o container não inicia com senha e TLS desligado (a senha
# trafegaria em claro).
# RUNBOOK_BASE_URL (usada na construção da imagem do Prometheus) é o endereço
# em que os runbooks são publicados, para o link das notificações.

# Redirecionamento OIDC (a interface web atende em WEB_PORT e encaminha /auth à API)
RECORVIA_OIDC_REDIRECT_URL=http://localhost:8080/auth/callback

# Portas publicadas no host (somente 127.0.0.1)
WEB_PORT=8080
API_PORT=18081
REDIS_PORT=6380
RABBITMQ_PORT=5672
KEYCLOAK_PORT=8180
PAYSIM_PORT=8090
MAILPIT_UI_PORT=8025
RABBITMQ_UI_PORT=15672
POSTGRES_PORT=5432
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
JAEGER_UI_PORT=16686
