{
  "realm": "recorvia",
  "enabled": true,
  "displayName": "Recorvia",
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "editUsernameAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "passwordPolicy": "length(12) and maxLength(128) and notUsername(undefined) and notEmail(undefined) and passwordHistory(5)",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 7200,
  "ssoSessionMaxLifespan": 43200,
  "actionTokenGeneratedByUserLifespan": 900,
  "internationalizationEnabled": true,
  "supportedLocales": ["pt-BR", "en"],
  "defaultLocale": "pt-BR",
  "eventsEnabled": true,
  "eventsExpiration": 7776000,
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "LOGOUT_ERROR",
    "CODE_TO_TOKEN_ERROR",
    "UPDATE_PASSWORD",
    "UPDATE_PASSWORD_ERROR",
    "RESET_PASSWORD",
    "RESET_PASSWORD_ERROR",
    "SEND_RESET_PASSWORD",
    "SEND_RESET_PASSWORD_ERROR",
    "VERIFY_EMAIL",
    "VERIFY_EMAIL_ERROR",
    "SEND_VERIFY_EMAIL",
    "SEND_VERIFY_EMAIL_ERROR",
    "UPDATE_EMAIL",
    "UPDATE_TOTP",
    "REMOVE_TOTP"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "smtpServer": {
    "host": "${KEYCLOAK_SMTP_HOST}",
    "port": "${KEYCLOAK_SMTP_PORT}",
    "from": "${KEYCLOAK_SMTP_FROM}",
    "fromDisplayName": "Recorvia",
    "auth": "true",
    "user": "${KEYCLOAK_SMTP_USERNAME}",
    "password": "${KEYCLOAK_SMTP_PASSWORD}",
    "starttls": "${KEYCLOAK_SMTP_STARTTLS}",
    "ssl": "${KEYCLOAK_SMTP_SSL}"
  },
  "clients": [
    {
      "clientId": "recorvia-web",
      "name": "Recorvia",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${RECORVIA_OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "rootUrl": "https://${RECORVIA_DOMAIN}",
      "baseUrl": "/",
      "redirectUris": ["https://${RECORVIA_DOMAIN}/auth/callback"],
      "webOrigins": ["https://${RECORVIA_DOMAIN}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://${RECORVIA_DOMAIN}##https://${RECORVIA_DOMAIN}/*"
      }
    }
  ]
}
