# Variáveis de produção do Recorvia (deploy/producao/compose.yaml).
# Guia: docs/operacao/implantacao.md.
#
# 1. Copie para .env nesta pasta (fora do Git): cp .env.example .env
# 2. Gere os segredos: bash gerar-segredos.sh .env
#    Toda linha com o valor GERAR recebe um valor aleatório; o arquivo fica
#    com permissão 600.
# 3. Preencha à mão os valores marcados com [PREENCHER] (domínios, e-mail e
#    SMTP). O script lista os que ainda estão com o valor de exemplo.
# 4. Guarde uma cópia do .env (e, separadamente, as chaves de cifragem) no
#    cofre de segredos. Sem as chaves, os dados cifrados no banco não podem
#    ser lidos (docs/operacao/backup-e-restauracao.md).
#
# Os segredos gerados usam só letras minúsculas e números (hexadecimal):
# entram em URLs de conexão sem precisar de escape. Se escolher uma senha à
# mão, evite aspas, barra invertida, @, :, / e # (as senhas dos papéis do
# banco recusam aspas simples e barra invertida e exigem 12 caracteres).

# ---------------------------------------------------------------- Versão
# Versão em produção: a mesma tag do Git do checkout (sem o "v"). As imagens
# da aplicação são construídas com esta etiqueta, e a anterior continua
# disponível para voltar atrás.
RECORVIA_VERSION=0.3.0

# ---------------------------------------------------------------- Domínios
# [PREENCHER] Endereço da aplicação (interface e API na mesma origem), sem
# https:// e sem barra. O DNS (registro A/AAAA) precisa apontar para o
# servidor antes da primeira subida, para o certificado ser emitido.
RECORVIA_DOMAIN=app.example.com
# [PREENCHER] Endereço do Keycloak (login). Subdomínio próprio, também com DNS
# apontando para o servidor.
KEYCLOAK_DOMAIN=auth.example.com
# [PREENCHER] E-mail da conta ACME (avisos da autoridade certificadora sobre
# os certificados).
ACME_EMAIL=operacao@example.com
# Endereços (CIDR, separados por espaço) que podem abrir o console de
# administração do Keycloak (/admin). O padrão libera todos; restrinja ao
# IP fixo da operação ou da VPN, por exemplo: 203.0.113.10/32
KEYCLOAK_ADMIN_ALLOWED_CIDRS=0.0.0.0/0 ::/0

# ---------------------------------------------------------------- PostgreSQL
# Superusuário do servidor: usado só pelo bootstrap dos papéis e dos bancos
# e pelo backup. Definido na criação do volume; para trocar depois, veja a
# rotação no guia.
POSTGRES_SUPERUSER_PASSWORD=GERAR
# Dono das tabelas do Recorvia (migrations).
RECORVIA_OWNER_PASSWORD=GERAR
# Papel da aplicação (API e worker; sujeito à RLS).
RECORVIA_APP_PASSWORD=GERAR
# Papel do Keycloak (banco "keycloak" no mesmo servidor).
KEYCLOAK_DB_PASSWORD=GERAR
# Conexões por processo (API e worker). O Keycloak usa até 20. A soma, com
# folga para o backup e as migrations, precisa ficar abaixo do
# max_connections do PostgreSQL (100 na imagem oficial).
#RECORVIA_DATABASE_MAX_CONNS=20

# ---------------------------------------------------------------- Redis
# Senha do Redis (sessões, fluxos de login e limites de taxa).
REDIS_PASSWORD=GERAR

# ---------------------------------------------------------------- RabbitMQ
# Definidos na criação do volume; para trocar a senha depois, veja o guia.
RABBITMQ_USER=recorvia
RABBITMQ_PASSWORD=GERAR

# ---------------------------------------------------------------- Keycloak
# Administrador temporário do realm master, criado só na primeira partida.
# Depois de criar um administrador definitivo (com segundo fator), apague
# este usuário no console (passo a passo no guia).
KEYCLOAK_ADMIN_USER=admin-temporario
KEYCLOAK_ADMIN_PASSWORD=GERAR
# Segredo do cliente recorvia-web: entra no realm na importação (primeira
# partida) e na API. Os dois precisam ser iguais; para trocar, veja o guia.
RECORVIA_OIDC_CLIENT_SECRET=GERAR

# ---------------------------------------------------------------- Chaves de cifragem
# Lista identificador:base64 de chaves de 32 bytes, separadas por vírgula, e
# a chave usada nas novas cifragens. O script gera uma chave com
# identificador da data (por exemplo k20261122). Guarde o par completo no
# cofre ANTES da primeira subida. Rotação em duas fases: guia e
# docs/operacao/backup-e-restauracao.md.
RECORVIA_ENCRYPTION_KEYS=GERAR
RECORVIA_ENCRYPTION_ACTIVE_KEY=GERAR
# Conferência das chaves contra o banco na partida da API e do worker:
# enforce (padrão), warn ou off. Mantenha enforce.
#RECORVIA_ENCRYPTION_STARTUP_CHECK=enforce
# Identificadores de chaves perdidas (só em recuperação; ver o runbook).
#RECORVIA_ENCRYPTION_LOST_KEYS=

# ---------------------------------------------------------------- E-mail (SMTP)
# [PREENCHER] Servidor de e-mail transacional (decisão pendente do dono: o
# guia lista o que avaliar). Usado pelo worker (cobranças, convites, portal)
# e pelo Keycloak (verificação de e-mail e troca de senha). Em produção o
# worker não sobe sem TLS.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=PREENCHER
SMTP_PASSWORD=PREENCHER
# TLS do worker: starttls (porta 587) ou tls (porta 465).
SMTP_TLS=starttls
# TLS do Keycloak, coerente com SMTP_TLS: starttls -> STARTTLS=true e
# SSL=false; tls -> STARTTLS=false e SSL=true.
KEYCLOAK_SMTP_STARTTLS=true
KEYCLOAK_SMTP_SSL=false
# [PREENCHER] Remetentes (domínio com SPF, DKIM e DMARC configurados no
# provedor de e-mail).
RECORVIA_SMTP_FROM=cobranca@example.com
KEYCLOAK_SMTP_FROM=acesso@example.com
# Tempo limite de cada envio.
#RECORVIA_SMTP_TIMEOUT=15s

# ---------------------------------------------------------------- Logs
#RECORVIA_LOG_LEVEL=info

# ---------------------------------------------------------------- Retenção
# Prazos do expurgo automático (dias). Os padrões abaixo valem sem definir
# nada; limites em docs/operacao/retencao-e-anonimizacao.md.
#RECORVIA_RETENTION_INBOX_DAYS=90
#RECORVIA_RETENTION_DEAD_LETTERS_DAYS=180
#RECORVIA_RETENTION_WEBHOOKS_DAYS=90
#RECORVIA_RETENTION_PROVIDER_WEBHOOK_PAYLOADS_DAYS=90
#RECORVIA_RETENTION_NOTIFICATION_CONTENT_DAYS=90
#RECORVIA_RETENTION_NOTIFICATIONS_DAYS=365
#RECORVIA_RETENTION_PORTAL_LINKS_DAYS=90
#RECORVIA_RETENTION_USAGE_EVENTS_DAYS=400
#RECORVIA_RETENTION_INVITATIONS_DAYS=90
#RECORVIA_RETENTION_BATCH_SIZE=500

# ---------------------------------------------------------------- Observabilidade (opcional)
# Perfil observability: docker compose --profile observability up -d.
# Com ele, descomente a linha abaixo para a API e o worker enviarem rastros.
#OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# Senha do admin do Grafana (gerada mesmo sem o perfil).
GRAFANA_ADMIN_PASSWORD=GERAR
# Retenção das métricas no Prometheus.
#PROMETHEUS_RETENTION=30d
# Portas das interfaces, publicadas só em 127.0.0.1 (acesso por túnel SSH).
#GRAFANA_PORT=3000
#PROMETHEUS_PORT=9090
#ALERTMANAGER_PORT=9093
#JAEGER_UI_PORT=16686
# Alertas por e-mail e webhook (docs/operacao/observabilidade.md). Com
# usuário e senha, mantenha ALERTMANAGER_SMTP_REQUIRE_TLS=true.
#ALERTMANAGER_SMTP_SMARTHOST=smtp.example.com:587
#ALERTMANAGER_SMTP_FROM=alertas@example.com
#ALERTMANAGER_SMTP_REQUIRE_TLS=true
#ALERTMANAGER_SMTP_USERNAME=
#ALERTMANAGER_SMTP_PASSWORD=
#ALERTMANAGER_EMAIL_TO=plantao@example.com
#ALERTMANAGER_EMAIL_TO_CRITICAL=
#ALERTMANAGER_WEBHOOK_URL=
#ALERTMANAGER_WEBHOOK_BEARER_TOKEN=
# Endereço em que os runbooks são publicados (link das notificações).
#RUNBOOK_BASE_URL=https://github.com/ricartefelipe/recorvia/blob/main/

# ---------------------------------------------------------------- Arquivos compose
# Extensões sem editar o compose.yaml (por exemplo, o backup contínuo):
#COMPOSE_FILE=compose.yaml:outro.yaml
